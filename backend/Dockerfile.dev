# Dockerfile.dev — Go Backend with Delve Debugger (dlv) for Development
FROM golang:1.22-alpine AS dev

WORKDIR /app

# Install git, build tools, and Delve debugger
RUN apk add --no-cache git gcc musl-dev && \
    go install github.com/go-delve/delve/cmd/dlv@latest

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Expose Go REST API (8080) and Delve Debugger Headless Port (4000)
EXPOSE 8080 4000

# Start Delve headless debug server listening on port 4000
CMD ["dlv", "debug", "./cmd/server", "--headless", "--listen=:4000", "--api-version=2", "--accept-multiclient", "--continue"]
